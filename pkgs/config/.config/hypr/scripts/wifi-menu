#!/usr/bin/env bash
# Wi-Fi 選單(nmcli + wofi)—— surrealism。列可用網路→選→連;已存的免密碼,新的跳密碼。
set -uo pipefail
STYLE="$HOME/.config/wofi/surrealism.css"
menu() { wofi --dmenu --conf /dev/null --width 460 --height 440 --style "$STYLE" "$@"; }

# 用快取秒開;背景觸發一次掃描,讓下次開更新(避免每次卡 2~4 秒)
nmcli device wifi rescan >/dev/null 2>&1 &
list=$(nmcli --get-values ACTIVE,SSID,SIGNAL,SECURITY dev wifi list --rescan no 2>/dev/null \
  | awk -F: '$2!="" && !seen[$2]++ {
      printf "%s %s  (%s%%)\n", ($1=="yes" ? "●" : "○"), $2, $3
    }')
[ -z "$list" ] && { notify-send "Wi-Fi" "掃不到網路"; exit 0; }

chosen=$(printf '%s\n' "$list" | menu -p "Wi-Fi") || exit 0
[ -z "$chosen" ] && exit 0
ssid=$(printf '%s' "$chosen" | sed -E 's/^[●○] //; s/  \([0-9]+%\)$//')

# 先試直接連(已存的 profile 免密碼)
if nmcli -w 8 device wifi connect "$ssid" >/dev/null 2>&1; then
  notify-send "Wi-Fi" "已連線:$ssid"
  exit 0
fi

# 需要密碼
pw=$(printf '' | menu --password -p "Password: $ssid") || exit 0
[ -z "$pw" ] && exit 0
if nmcli -w 15 device wifi connect "$ssid" password "$pw" >/dev/null 2>&1; then
  notify-send "Wi-Fi" "已連線:$ssid"
else
  notify-send "Wi-Fi" "連線失敗:$ssid"
fi
